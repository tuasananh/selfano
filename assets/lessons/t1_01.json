    "theory": {
      "summary": "Stepwise right-hand 5-finger melody over sustained left-hand I-V-I bass anchors in C Major.",
      "pattern_tip": "Read intervals by contour (steps of a 2nd and 3rds) rather than naming every isolated note.",
      "technique_tip": "Keep wrists supple and let fingers rest gently over C4-G4 without lifting unused fingers.",
      "ballade_link": "Establishes effortless landmark reading (G4, C4, F3) needed before dense Romantic textures."
    }
