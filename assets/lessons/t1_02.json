    "id": "t1_02",
    "tier": 1,
    "order_in_tier": 2,
    "title": "Parallel & Contrary 5-Finger Motion",
    "composer_source": "Study after Carl Czerny, Op. 599 No. 11",
    "key": {
      "fifths": 0,
      "mode": "major"
    },
    "time_signature": {
      "numerator": 4,
      "denominator": 4
    },
    "target_bpm": 84.0,
    "theory": {
      "summary": "Synchronizes both hands in parallel and contrary 5-finger motion over classic I-IV-V7-I harmony.",
      "pattern_tip": "Mirror your thumbs on C4 and G3 when hands move in contrary motion; read intervals relative to the 5-finger frame.",
      "technique_tip": "Strike each synchronized pair cleanly together with quiet, balanced fingertips.",
      "ballade_link": "Builds effortless two-hand coordination before independent Baroque and Romantic voices.",
      "concept_title": "Parallel vs. Contrary Five-Finger Coordination",
      "concept_paragraphs": [
        "Playing two hands together gets dramatically easier when you notice their directional symmetry. In parallel motion both hands rise or fall together; in contrary motion your thumbs mirror outward from the center and inward back home.",
        "Track the distance between consecutive notes (step, repeat, or skip of a 3rd) instead of reading two separate staves one letter at a time."
      ],
      "form_map": [
        {
          "phrase_label": "Phrase A (Bars 1-4)",
          "role": "Mirror opening unfolding into an energetic Dominant seventh (G7) half cadence."
        },
        {
          "phrase_label": "Phrase B (Bars 5-8)",
          "role": "Parallel and contrary scalar reply cadencing squarely onto C Major (I)."
        }
      ],
      "practice_steps": [
        "1. Spot which measures move in mirror symmetry (same finger numbers in both hands!).",
        "2. Run Chord Skeleton mode once to lock in the I - IV - V7 - I harmony shifts.",
        "3. Practice Hands Together slowly, landing synchronized vertical pairs cleanly together.",
        "4. Build cleanly from 60% to 100% (84 BPM) keeping arms weight-balanced and tension-free."
      ],
      "audio_examples": [
        {
          "label": "Classic Cadential Arc (I -> IV -> V -> V7 -> I)",
          "caption": "C -> F -> G -> G7 -> C",
          "chords": [
            "C",
            "F",
            "G",
            "G7",
            "C"
          ]
        }
      ]
    },
    "tempo_marking": "Moderato"
  },
