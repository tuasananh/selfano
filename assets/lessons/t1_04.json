    "theory": {
      "summary": "Introduces the G-major key signature (F#) and graceful 3/4 waltz accompaniment (ONE-two-three).",
      "pattern_tip": "Every F in this score is F# automatically from the key signature\u2014spot the F#4 leading tone resolving to G4.",
      "technique_tip": "Keep beat 1 resonant in the left hand and beats 2-3 lighter for an authentic waltz lilt.",
      "ballade_link": "Trains triple-meter weight balance foundational for 3/4 waltzes and 6/4 barcarolle phrasing."
    }
