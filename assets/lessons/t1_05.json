    "theory": {
      "summary": "Trains F-major reading (Bb key signature), dotted half notes, and smooth I-IV-ii-V-I triad transitions.",
      "pattern_tip": "Track the shared common tone C4/F3 between F major and Bb/C7 grips so your left hand barely moves.",
      "technique_tip": "Balance the dotted half notes cleanly above quiet blocked triads in the left hand.",
      "ballade_link": "Builds flat-key reading fluency and singing upper-voice phrasing."
    }
