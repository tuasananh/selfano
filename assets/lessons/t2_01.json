    "tier": 2,
    "order_in_tier": 1,
    "title": "Intro to Alberti Bass",
    "composer_source": "Study after Carl Czerny, Op. 599 No. 22",
    "key": {
      "fifths": 0,
      "mode": "major"
    },
    "time_signature": {
      "numerator": 4,
      "denominator": 4
    },
    "target_bpm": 88.0,
    "theory": {
      "summary": "Automates the Classical Alberti bass pattern (low-high-mid-high 8ths) so you read chords as single grips.",
      "pattern_tip": "See each 4-eighth Alberti group as one static chord (C, G7/B, F, G7) rather than eight separate notes.",
      "technique_tip": "Use gentle forearm rotation toward thumb and pinky; keep the Alberti bass softer than the singing melody.",
      "ballade_link": "Frees reading bandwidth for melodic contour over flowing broken-chord accompaniments."
    }
  },
