    "theory": {
      "summary": "Combines a buoyant 3/4 bass-chord-chord waltz left hand with clean thumb-under right-hand scale shifts.",
      "pattern_tip": "Prepare the thumb tuck (finger 3 -> 1) before reaching C5 so the rising G-major line flows seamlessly.",
      "technique_tip": "Keep the left-hand wrist light on the leap from the low bass note up to the mid-register chord.",
      "ballade_link": "Direct training for Chopin's waltz and 6/4 bass-to-chord left-hand leaps."
    }
  },
