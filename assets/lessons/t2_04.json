{
  "meta": {
    "id": "t2_04",
    "tier": 2,
    "order_in_tier": 4,
    "title": "Dotted Rhythms & Ties",
    "composer_source": "Study after Carl Czerny, Op. 599 No. 38",
    "key": {
      "fifths": -1,
      "mode": "major"
    },
    "time_signature": {
      "numerator": 4,
      "denominator": 4
    },
    "target_bpm": 84.0,
    "theory": {
      "summary": "F Major cantabile study combining dotted-quarter + eighth subdivisions with barline ties.",
      "pattern_tip": "Feel the hidden 8th-note grid ('1-and-2-AND') so the 8th after the dot lands crisply without rushing.",
      "technique_tip": "Hold tied notes silently across the barline while the left hand changes harmony underneath.",
      "ballade_link": "Syncopated ties and dotted cantabile rhythms underpin Chopin's singing right-hand themes.",
      "concept_title": "Dotted Quarter Rhythms & Expressive Barline Ties",
      "concept_paragraphs": [
        "A dotted quarter note steals half of beat 2\u2014lasting three 8th-note pulses\u2014so the following eighth note arrives cleanly on the 'AND' of 2. Counting the underlying 8th-note grid ('1-and-2-AND') makes dotted rhythms effortless and musical rather than guessed.",
        "Meanwhile, barline ties suspend the melody tone gracefully across harmonic shifts below, creating sweet singing friction that resolves by step."
      ],
      "form_map": [
        {
          "phrase_label": "Phrase A (Bars 1-4)",
          "role": "Cantabile dotted-quarter F-major motif gently bending into relative minor Dm (vi)."
        },
        {
          "phrase_label": "Phrase B (Bars 5-8)",
          "role": "Rises through Bb (IV) and Dm with tied suspensions over C7 tension."
        },
        {
          "phrase_label": "Phrase C (Bars 9-12)",
          "role": "Resolves smoothly through ii (Gm) and V7 (C7) into a serene Tonic ending."
        }
      ],
      "practice_steps": [
        "1. Tap the dotted-quarter + eighth pattern against a steady pulse ('1-and-2-AND-3-4').",
        "2. Check every tie in the score: hold the tied key silently when the harmony shifts beneath it.",
        "3. Keep LH accompaniments soft and rounded under the singing soprano line.",
        "4. Aim for smooth expressive phrasing at 84 BPM."
      ],
      "audio_examples": [
        {
          "label": "Deceptive Warmth via Submediant vi (I -> V7 -> vi)",
          "caption": "F -> C7 -> Dm -> Bb -> C7 -> F",
          "chords": [
            "F",
            "C7",
            "Dm",
            "Bb",
            "C7",
            "F"
          ]
        }
      ]
    },
    "tempo_marking": "Moderato deciso"
  },
