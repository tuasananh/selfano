    "target_bpm": 112.0,
    "theory": {
      "summary": "Crisp 2/4 A-minor etude pairing brisk 16th-note 5-finger bursts with rhythmic chord accompaniment and C-major contrast.",
      "pattern_tip": "Group every four 16th notes as one explosive fingertip gesture (A-B-C-B-A) landing squarely on beat 2.",
      "technique_tip": "Keep the wrist loose during the 16th-note bursts and rebound cleanly off the final 8th note.",
      "ballade_link": "Builds rapid, articulate 16th-note finger independence for Chopin's ornamental figuration."
    }
  },
