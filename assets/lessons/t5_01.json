    "theory": {
      "summary": "Complete 16-bar Chopin prelude in A Major (3 sharps) pairing wide left-hand leaps with poised 3/4 cantabile chords and V7/ii color.",
      "pattern_tip": "Trace the alternating dominant-to-tonic arches: Bars 1-4 (E7 -> A), Bars 5-8 (E7 -> A), peaking at the famous F#7 (V7/ii) chord in Bars 11-12.",
      "technique_tip": "Roll any wide left-hand reach lightly without tension and voice the top soprano note of every right-hand chord.",
      "ballade_link": "Trains Chopin's wide left-hand stride, three-sharp reading, and luminous secondary-dominant voicing."
    }
  },
