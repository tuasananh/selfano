    },
    "target_bpm": 96.0,
    "theory": {
      "summary": "Trains the iconic 6/4 barcarolle-waltz accompaniment and singing G-minor melody of Ballade No. 1.",
      "pattern_tip": "Hear each 6/4 bar as two graceful three-beat groups: bass on beat 1, warm inner chord on beat 2, breath on beat 3.",
      "technique_tip": "Keep the left hand light and buoyant on the bass-to-chord leaps so the right-hand cantabile melody floats above.",
      "ballade_link": "Direct rhythmic, harmonic (i -> iv -> V7/V -> V7 -> bII6 -> i6/4 -> V7 -> i), and textural bridge to Op. 23 mm. 8-23."
    }
  },
