    "title": "Ballade No. 1 - Moderato Theme Study (6/4 Lilt)",
    "composer_source": "Frederic Chopin, Op. 23 mm. 8-23 Idiom Study",
    "key": {
      "fifths": -2,
      "mode": "minor"
    },
    "time_signature": {
      "numerator": 6,
